<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key><string>Feather</string>
  <key>CFBundleDisplayName</key><string>Feather</string>
  <!-- Langue de l'application : les menus du système et de WebKit (clic droit) en français -->
  <key>CFBundleDevelopmentRegion</key><string>fr</string>
  <key>CFBundleLocalizations</key><array><string>fr</string></array>
  <key>CFBundleIdentifier</key><string>app.feather.browser</string>
  <key>CFBundleIconFile</key><string>Feather</string>
  <key>CFBundleExecutable</key><string>feather</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleVersion</key><string>0.6.0</string>
  <key>CFBundleShortVersionString</key><string>0.6.0</string>
  <key>LSMinimumSystemVersion</key><string>11.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPhotoLibraryAddUsageDescription</key><string>Feather ajoute à Photos les images que vous enregistrez depuis une page.</string>
  <!-- Caméra, micro et position : sans ces textes, macOS refuse l'accès (ou ferme Feather)
       dès qu'un site autorisé les demande, par exemple pour un appel vidéo. -->
  <key>NSCameraUsageDescription</key><string>Les sites que vous autorisez peuvent utiliser la caméra, par exemple pour un appel vidéo.</string>
  <key>NSMicrophoneUsageDescription</key><string>Les sites que vous autorisez peuvent utiliser le micro, par exemple pour un appel.</string>
  <key>NSLocationUsageDescription</key><string>Les sites que vous autorisez peuvent connaître votre position, par exemple pour une carte.</string>
  <key>NSLocationWhenInUseUsageDescription</key><string>Les sites que vous autorisez peuvent connaître votre position, par exemple pour une carte.</string>
</dict>
</plist>
